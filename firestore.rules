rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPlayerProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'balance',
        'freeSpinsLeft',
        'freeSpinPot',
        'freeSpinsPlayed',
        'totalSpins',
        'totalWon',
        'biggestWin',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'photoUrl',
        'balance',
        'freeSpinsLeft',
        'freeSpinPot',
        'freeSpinsPlayed',
        'totalSpins',
        'totalWon',
        'biggestWin',
        'lastDailyBonusAt',
        'dailyBonusStreak',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.uid)
      && data.uid == request.auth.uid
      && data.uid == userId
      && data.displayName is string
      && data.displayName.size() >= 1
      && data.displayName.size() <= 64
      && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512))
      && data.balance is number
      && data.balance >= 0
      && data.balance <= 100000000
      && data.freeSpinsLeft is int
      && data.freeSpinsLeft >= 0
      && data.freeSpinsLeft <= 1000
      && data.freeSpinPot is number
      && data.freeSpinPot >= 0
      && data.freeSpinPot <= 100000000
      && data.freeSpinsPlayed is int
      && data.freeSpinsPlayed >= 0
      && data.freeSpinsPlayed <= 1000
      && data.totalSpins is int
      && data.totalSpins >= 0
      && data.totalWon is number
      && data.totalWon >= 0
      && data.biggestWin is number
      && data.biggestWin >= 0
      && (!('lastDailyBonusAt' in data) || data.lastDailyBonusAt is timestamp)
      && (!('dailyBonusStreak' in data) || (data.dailyBonusStreak is int && data.dailyBonusStreak >= 0 && data.dailyBonusStreak <= 10000))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /players/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidPlayerProfile(incoming(), userId)
        && (!('lastDailyBonusAt' in incoming()) || incoming().lastDailyBonusAt == request.time)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidPlayerProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Sync game state (bankroll, free spins, stats)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'balance',
            'freeSpinsLeft',
            'freeSpinPot',
            'freeSpinsPlayed',
            'totalSpins',
            'totalWon',
            'biggestWin',
            'updatedAt'
          ])
          ||
          // Action 2: Sync profile metadata
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'photoUrl',
            'updatedAt'
          ])
          ||
          // Action 3: Claim 24-hour Daily Login Bonus (server-enforced cooldown & reward cap)
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'balance',
              'lastDailyBonusAt',
              'dailyBonusStreak',
              'updatedAt'
            ])
            && incoming().lastDailyBonusAt == request.time
            && (!('lastDailyBonusAt' in existing()) || request.time >= existing().lastDailyBonusAt + duration.value(24, 'h'))
            && incoming().balance >= existing().balance
            && incoming().balance <= existing().balance + 50
          )
        );

      allow delete: if false;
    }
  }
}
