rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isValidPlayerProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'balance',
        'freeSpinsLeft',
        'freeSpinPot',
        'freeSpinsPlayed',
        'totalSpins',
        'totalWon',
        'biggestWin',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'photoUrl',
        'balance',
        'freeSpinsLeft',
        'freeSpinPot',
        'freeSpinsPlayed',
        'totalSpins',
        'totalWon',
        'biggestWin',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.uid)
      && data.uid == request.auth.uid
      && data.uid == userId
      && data.displayName is string
      && data.displayName.size() >= 1
      && data.displayName.size() <= 64
      && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512))
      && data.balance is number
      && data.balance >= 0
      && data.balance <= 100000000
      && data.freeSpinsLeft is int
      && data.freeSpinsLeft >= 0
      && data.freeSpinsLeft <= 1000
      && data.freeSpinPot is number
      && data.freeSpinPot >= 0
      && data.freeSpinPot <= 100000000
      && data.freeSpinsPlayed is int
      && data.freeSpinsPlayed >= 0
      && data.freeSpinsPlayed <= 1000
      && data.totalSpins is int
      && data.totalSpins >= 0
      && data.totalWon is number
      && data.totalWon >= 0
      && data.biggestWin is number
      && data.biggestWin >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /players/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidPlayerProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidPlayerProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'balance',
            'freeSpinsLeft',
            'freeSpinPot',
            'freeSpinsPlayed',
            'totalSpins',
            'totalWon',
            'biggestWin',
            'updatedAt'
          ])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'photoUrl',
            'updatedAt'
          ])
        );

      allow delete: if false;
    }
  }
}
